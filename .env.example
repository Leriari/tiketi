# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=true

# ── Database ───────────────────────────────────────────────────────────────────
# Development (SQLite fallback — no setup needed)
DATABASE_URL=sqlite:///./dev.db

# Production (PostgreSQL)
# DATABASE_URL=postgresql://tiketi:strongpassword@localhost:5432/tiketi_db

# ── Redis (Celery task queue + OTP store) ──────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── M-Pesa / Safaricom Daraja ──────────────────────────────────────────────────
# Get these from https://developer.safaricom.co.ke
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_lipa_na_mpesa_passkey_here

# Your server's public URL — Daraja will POST payment results here.
# Use ngrok for local dev: https://ngrok.com
MPESA_CALLBACK_URL=https://your-domain.com/api/v1/payments/mpesa/callback

# sandbox | production
MPESA_ENV=sandbox

# ── JWT Auth ───────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

# ── OTP / SMS ──────────────────────────────────────────────────────────────────
OTP_EXPIRE_SECONDS=300
# Get from https://account.africastalking.com
AFRICASTALKING_API_KEY=your_africastalking_api_key
AFRICASTALKING_USERNAME=sandbox

# ── TOTP ───────────────────────────────────────────────────────────────────────
TOTP_ISSUER=TiketiKE

# ── Phase 2: Blockchain (add when ready) ──────────────────────────────────────
# BLOCKCHAIN_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/your_key
# DEPLOYER_PRIVATE_KEY=your_wallet_private_key
# NFT_CONTRACT_ADDRESS=0x...
