# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=true

# ── Database ───────────────────────────────────────────────────────────────────
# Development (SQLite fallback — no setup needed)
DATABASE_URL=sqlite:///./dev.db

# Production (PostgreSQL)
# DATABASE_URL=postgresql://tiketi:strongpassword@localhost:5432/tiketi_db

# ── Redis (Celery task queue + OTP store) ──────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── M-Pesa / Safaricom Daraja ──────────────────────────────────────────────────
# Get these from https://developer.safaricom.co.ke
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_lipa_na_mpesa_passkey_here

# Your server's public URL — Daraja will POST payment results here.
# Use ngrok for local dev: https://ngrok.com
MPESA_CALLBACK_URL=https://your-domain.com/api/v1/payments/mpesa/callback

# sandbox | production
MPESA_ENV=sandbox

# ── JWT Auth ───────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

# ── OTP ────────────────────────────────────────────────────────────────────────
# SMS delivery is out of scope for this project — OTPs are logged to console.
OTP_EXPIRE_SECONDS=300

# ── TOTP ───────────────────────────────────────────────────────────────────────
TOTP_ISSUER=TiketiKE

# ── Blockchain (Base Sepolia) — optional, minting stays a logged no-op stub
# until all three of these are set. See contracts/ for the TiketiNFT
# contract and its deploy script (contracts/scripts/deploy.js).
BLOCKCHAIN_RPC_URL=
NFT_CONTRACT_ADDRESS=
# Private key of the backend's relayer/minter wallet — the address that
# calls mintTicket/markUsed on-chain and receives royalties. Never commit
# this. Can be the same wallet as contracts/.env's DEPLOYER_PRIVATE_KEY for
# a small deployment, or a separate one.
MINTER_PRIVATE_KEY=
