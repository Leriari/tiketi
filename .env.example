# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=true

# ── Database ───────────────────────────────────────────────────────────────────
# Development (SQLite fallback — no setup needed)
DATABASE_URL=sqlite:///./dev.db

# Production (PostgreSQL)
# DATABASE_URL=postgresql://tiketi:strongpassword@localhost:5432/tiketi_db

# ── Redis (Celery task queue + OTP store) ──────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── M-Pesa / Safaricom Daraja ──────────────────────────────────────────────────
# Get these from https://developer.safaricom.co.ke
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_lipa_na_mpesa_passkey_here

# Your server's public URL — Daraja will POST payment results here.
# Use ngrok for local dev: https://ngrok.com
MPESA_CALLBACK_URL=https://your-domain.com/api/v1/payments/mpesa/callback

# sandbox | production
MPESA_ENV=sandbox

# ── JWT Auth ───────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

# ── OTP ────────────────────────────────────────────────────────────────────────
OTP_EXPIRE_SECONDS=300
# console: logs the code to the server log (dev default).
# inbox: writes to the notifications table, readable via the dev-only
#   GET /dev/otp-inbox endpoint. The app refuses to start with this value
#   unless APP_ENV=development — see app/services/otp_delivery.py.
# sms: raises NotImplementedError — no gateway is configured; nothing in
#   this project's scope sends a real SMS.
OTP_DELIVERY_CHANNEL=console

# Optional: Firebase Authentication — real SMS codes for phone login and
# "Continue with Google". From Firebase console -> Project settings ->
# General -> Your apps -> (web app) config. Enable the Phone and Google
# providers under Authentication -> Sign-in method, and add your frontend's
# domain (localhost is there by default) under Authentication -> Settings ->
# Authorized domains. Leave empty to use the built-in dev OTP flow instead.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
# true = phone codes by real SMS via Firebase (enable the Phone provider
# first; it needs the Blaze plan). false = the built-in OTP flow.
FIREBASE_PHONE_AUTH=false

# ── TOTP ───────────────────────────────────────────────────────────────────────
TOTP_ISSUER=TiketiKE

# ── Credential encryption ──────────────────────────────────────────────────────
# Encrypts Barcode.token (the TOTP secret seed) at rest. Required — generate
# with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# ── Blockchain (Base Sepolia) — optional, minting stays a logged no-op stub
# until all three of these are set. See contracts/ for the TiketiNFT
# contract and its deploy script (contracts/scripts/deploy.js).
BLOCKCHAIN_RPC_URL=
NFT_CONTRACT_ADDRESS=
# Only after deploying a new TiketiNFT version: the previous contract's
# address. Tickets minted on it stay there (no on-chain resale floor).
NFT_LEGACY_CONTRACT_ADDRESS=
# Private key of the backend's relayer/minter wallet — the address that
# calls mintTicket/markUsed on-chain and receives royalties. Never commit
# this. Can be the same wallet as contracts/.env's DEPLOYER_PRIVATE_KEY for
# a small deployment, or a separate one.
MINTER_PRIVATE_KEY=

# ── Card payments (Paystack) — optional; no card option at checkout until set.
# Test secret key (sk_test_…) from dashboard.paystack.com → Settings →
# API Keys & Webhooks. It also verifies webhooks, sent to
# <API>/api/v1/payments/paystack/webhook. Locally the webhook isn't needed:
# checkout asks Paystack directly when the buyer comes back.
PAYSTACK_SECRET_KEY=

# ── Payouts (M-Pesa B2C to phones, B2B to paybills/tills) — optional.
# From the Daraja portal: the shortcode payouts are sent from, its API
# operator ("initiator") name, and the operator's password encrypted with
# Safaricom's certificate (the portal's Security Credential generator).
# Sandbox values are on the Test Credentials page. Results come back to
# <API>/api/v1/payouts/results/..., built from MPESA_CALLBACK_URL's host.
# Unset: withdrawals and payout requests wait for an admin to pay by hand.
MPESA_PAYOUT_SHORTCODE=
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
