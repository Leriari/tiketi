# Base Sepolia RPC endpoint (e.g. from Alchemy, Infura, or a public RPC)
BASE_SEPOLIA_RPC=

# Private key of the deployer wallet, funded with Base Sepolia test ETH.
# Never commit this. Only needed to deploy — not needed to compile or test.
DEPLOYER_PRIVATE_KEY=

# Optional — the minter/relayer wallet address (see the `minter` role in
# TiketiNFT.sol). Defaults to the deployer's own address if unset.
MINTER_ADDRESS=
